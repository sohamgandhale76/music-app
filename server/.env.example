# ─── Server Configuration ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Allowed CORS origin — set to your frontend URL in production
# Use * for development (allow all origins)
CORS_ORIGIN=*

# Maximum audio chunk upload size (MB)
MAX_CHUNK_SIZE_MB=10

# Room TTL in milliseconds before auto-deletion (default: 2 hours)
ROOM_TTL_MS=7200000

# Winston log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# ─── Telegram Bot Cloud Storage (Optional) ──────────────────────────────────
# Set these to enable zero-disk-storage hosting on Telegram's CDN (supports files of any size)
# To create a bot: message @BotFather on Telegram
# To get your chat/channel ID: add the bot to a chat and start it, it will print your Chat ID
# TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=-1001234567890

